# データベース接続文字列
# 開発環境(SQLite): file:./dev.db
# 本番環境(PostgreSQL例): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# セッション署名用シークレット(本番では必ず長いランダム文字列に変更すること)
# 生成例: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# 初期管理者アカウント(seed実行時のみ使用。本番運用では管理画面 or 別途スクリプトで変更してください)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# 画像ストレージ設定
# STORAGE_DRIVER: "local" | "s3"
STORAGE_DRIVER="local"

# STORAGE_DRIVER=s3 の場合に使用(S3互換ストレージ)
# 以下はCloudflare R2の例。R2ダッシュボード > R2 > 該当バケット > "Settings" で
# エンドポイント(S3 API)を確認し、"Manage R2 API Tokens" でアクセスキーを発行する。
# バケットは既定で非公開のため、"Public access" を有効化するかカスタムドメインを
# 紐付けて S3_PUBLIC_BASE_URL に設定すること(公開しないと画像が表示できない)。
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="travel-estate-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# メール通知(任意。未設定の場合は問い合わせ保存のみ行いメール送信はスキップされます)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="no-reply@example.com"
# MAIL_TO_ADMIN="admin@example.com"

# サイトURL(sitemap/OGP用)
SITE_URL="http://localhost:3000"
